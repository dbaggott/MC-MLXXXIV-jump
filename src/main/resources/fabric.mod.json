{
  "schemaVersion": 1,
  "id": "mcmlxxxiv_jump",
  "version": "${version}",
  "name": "Auto-jump",
  "description": "Go ahead and jump!  Minecraft Fabric mod adding configurable auto-jumping capabilities.",
  "authors": [
    "dbaggott"
  ],
  "contact": {
    "sources": "https://github.com/dbaggott/MC-MLXXXIV-jump"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.dnbg.minecraft.jump.JumpClient"
    ],
    "modmenu": [
      "io.dnbg.minecraft.jump.ModMenuEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_floor}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_floor}",
    "cloth-config": ">=${cloth_config_floor}"
  },
  "mixins": [
    "mcmlxxxiv_jump.mixins.json"
  ],
  "suggests": {
    "modmenu": ">=${modmenu_floor}"
  }
}
